# ==============================================================================
# Smart Routine & Management Backend Environment Configuration
# ==============================================================================

# MongoDB Atlas Connection URI (Include username, password, cluster, and default db)
# In production, ensure Network Access in Atlas whitelist allows your server IP (or 0.0.0.0/0 for serverless)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/smart_routine_db?retryWrites=true&w=majority

# Name of the MongoDB database
MONGODB_DB=smart_routine_db

# Secret key for signing and verifying JWT authentication tokens
# In production, use a high-entropy cryptographically random string (min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_production

# JWT Token Expiration (e.g. 7d, 30d, 24h)
JWT_EXPIRES_IN=30d

# Node Environment ('development' or 'production')
NODE_ENV=development

# Server Port (default 5000)
PORT=5000